  <String Id="Lcid" Value="1040" />
  <String Id="ProductName" Value="Feature Heist for Windows 11" />
  <String Id="Downgrade" Value="Una versione pi&#249; recente di Feature Heist &#232; gi&#224; installata." />
  <String Id="NeedWin11" Value="Feature Heist richiede Windows 11 a 64 bit." />
  <String Id="FeatMpio" Value="MPIO" />
  <String Id="FeatMpioDesc" Value="Multipath I/O con MSDSM (stack di archiviazione)." />
