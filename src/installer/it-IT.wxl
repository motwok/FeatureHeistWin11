  <String Id="FeatLbfoDesc" Value="Driver per il teaming delle schede di rete (stack di rete)." />
  <String Id="FeatAdmin" Value="LbfoAdmin" />
  <String Id="FeatAdminDesc" Value="Console di gestione del teaming delle schede di rete." />
  <String Id="SrcTitle" Value="Supporto di Windows Server" />
  <String Id="SrcDesc" Value="I file vengono estratti dal supporto di Windows Server della stessa build." />
  <String Id="SrcIso" Value="ISO di Windows Server, install.wim o unit&#224;. Lasciare vuoto se i file sono gi&#224; stati estratti." />
  <String Id="SrcPayload" Value="Cartella per i file estratti o cartella con file estratti in precedenza:" />
  <String Id="SrcBrowse" Value="&amp;Sfoglia..." />
