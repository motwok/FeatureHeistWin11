  <String Id="FeatAdmin" Value="LbfoAdmin" />
  <String Id="FeatAdminDesc" Value="H&#225;l&#243;zati k&#225;rty&#225;k csoportos&#237;t&#225;s&#225;nak fel&#252;gyeleti konzolja." />
