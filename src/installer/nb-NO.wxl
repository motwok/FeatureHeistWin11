  <String Id="ForeignTitle" Value="LBFO er allerede installert" />
  <String Id="ForeignDesc" Value="Installert av et annet verkt&#248;y, f.eks. Windows11LBFO." />
  <String Id="ForeignText" Value="LBFO (NIC-teaming) er allerede installert av et annet verkt&#248;y, f.eks. Windows11LBFO. Feature Heist lar det og teamene v&#230;re uendret; LbfoAdmin fungerer med det. Bruk tools\Migrate-FromWindows11LBFO.ps1 fra https://github.com/motwok/FeatureHeistWin11 for &#229; erstatte det. Hopp over LBFO og installer de andre valgte pakkene, eller avbryt." />
  <String Id="ForeignSkip" Value="&amp;Hopp over LBFO" />
  <String Id="ForeignOnly" Value="LBFO er allerede installert av et annet verkt&#248;y (f.eks. Windows11LBFO) og er den eneste valgte pakken. Bruk tools\Migrate-FromWindows11LBFO.ps1 fra https://github.com/motwok/FeatureHeistWin11 for &#229; erstatte det." />
