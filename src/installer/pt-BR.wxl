  <String Id="SrcTitle" Value="M&#237;dia do Windows Server" />
  <String Id="SrcDesc" Value="Os arquivos s&#227;o extra&#237;dos da sua m&#237;dia do Windows Server da mesma compila&#231;&#227;o." />
