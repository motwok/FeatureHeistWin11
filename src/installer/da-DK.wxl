  <String Id="ForeignTitle" Value="LBFO er allerede installeret" />
  <String Id="ForeignDesc" Value="Installeret af et andet v&#230;rkt&#248;j, f.eks. Windows11LBFO." />
  <String Id="ForeignText" Value="LBFO (NIC-teaming) er allerede installeret af et andet v&#230;rkt&#248;j, f.eks. Windows11LBFO. Feature Heist lader det og dets teams v&#230;re u&#230;ndret; LbfoAdmin fungerer med det. Brug tools\Migrate-FromWindows11LBFO.ps1 fra https://github.com/motwok/FeatureHeistWin11 for at erstatte det. Spring LBFO over, og installer de andre valgte pakker, eller annuller." />
  <String Id="ForeignSkip" Value="&amp;Spring LBFO over" />
  <String Id="ForeignOnly" Value="LBFO er allerede installeret af et andet v&#230;rkt&#248;j (f.eks. Windows11LBFO) og er den eneste valgte pakke. Brug tools\Migrate-FromWindows11LBFO.ps1 fra https://github.com/motwok/FeatureHeistWin11 for at erstatte det." />
</WixLocalization>
