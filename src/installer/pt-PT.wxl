  <String Id="SrcTitle" Value="Suporte de dados do Windows Server" />
  <String Id="SrcDesc" Value="Os ficheiros s&#227;o extra&#237;dos do seu suporte de dados do Windows Server da mesma compila&#231;&#227;o." />
  <String Id="SrcIso" Value="ISO do Windows Server, install.wim ou unidade. Deixe vazio se os ficheiros j&#225; foram extra&#237;dos." />
