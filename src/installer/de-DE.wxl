  <String Id="SrcTitle" Value="Windows Server-Medium" />
  <String Id="SrcDesc" Value="Die Dateien werden aus Ihrem Windows Server-Medium desselben Builds extrahiert." />
  <String Id="SrcIso" Value="Windows Server-ISO, install.wim oder Laufwerk. Leer lassen, wenn die Dateien schon extrahiert sind." />
