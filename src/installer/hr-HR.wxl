  <String Id="ForeignTitle" Value="LBFO je ve&#263; instaliran" />
  <String Id="ForeignDesc" Value="Instalirao ga je drugi alat, npr. Windows11LBFO." />
  <String Id="ForeignText" Value="LBFO (grupiranje mre&#382;nih kartica) ve&#263; je instaliran drugim alatom, npr. Windows11LBFO. Feature Heist ostavlja njega i njegove timove nepromijenjenima; LbfoAdmin radi s njim. Za zamjenu upotrijebite tools\Migrate-FromWindows11LBFO.ps1 s https://github.com/motwok/FeatureHeistWin11. Presko&#269;ite LBFO i instalirajte ostale odabrane pakete ili odustanite." />
  <String Id="ForeignSkip" Value="&amp;Presko&#269;i LBFO" />
  <String Id="ForeignOnly" Value="LBFO je ve&#263; instaliran drugim alatom (npr. Windows11LBFO) i jedini je odabrani paket. Za zamjenu upotrijebite tools\Migrate-FromWindows11LBFO.ps1 s https://github.com/motwok/FeatureHeistWin11." />
