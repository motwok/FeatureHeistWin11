  <String Id="FeatMpioDesc" Value="Multipath I/O z MSDSM (stos magazynu)." />
  <String Id="FeatLbfo" Value="LBFO" />
  <String Id="FeatLbfoDesc" Value="Sterownik tworzenia zespo&#322;u kart sieciowych (stos sieciowy)." />
  <String Id="FeatAdmin" Value="LbfoAdmin" />
  <String Id="FeatAdminDesc" Value="Konsola zarz&#261;dzania zespo&#322;ami kart sieciowych." />
  <String Id="SrcTitle" Value="No&#347;nik systemu Windows Server" />
  <String Id="SrcDesc" Value="Pliki s&#261; wyodr&#281;bniane z no&#347;nika Windows Server w tej samej kompilacji." />
  <String Id="SrcIso" Value="Obraz ISO systemu Windows Server, install.wim lub dysk. Pozostaw puste, je&#347;li pliki zosta&#322;y ju&#380; wyodr&#281;bnione." />
  <String Id="SrcPayload" Value="Folder na wyodr&#281;bnione pliki lub folder z wcze&#347;niej wyodr&#281;bnionymi plikami:" />
  <String Id="SrcBrowse" Value="&amp;Przegl&#261;daj..." />
