  <String Id="SrcClaimIscsi" Value="&amp;iSCSI" />
  <String Id="SrcClaimSas" Value="&amp;SAS (przejmuje tak&#380;e lokalne dyski SAS, by&#263; mo&#380;e dysk systemowy)" />
  <String Id="ForeignTitle" Value="LBFO jest ju&#380; zainstalowany" />
  <String Id="ForeignDesc" Value="Zainstalowany przez inne narz&#281;dzie, np. Windows11LBFO." />
  <String Id="ForeignText" Value="LBFO (tworzenie zespo&#322;u kart sieciowych) jest ju&#380; zainstalowany przez inne narz&#281;dzie, np. Windows11LBFO. Feature Heist pozostawia go wraz z zespo&#322;ami bez zmian; LbfoAdmin z nim wsp&#243;&#322;pracuje. Aby go zast&#261;pi&#263;, u&#380;yj tools\Migrate-FromWindows11LBFO.ps1 z https://github.com/motwok/FeatureHeistWin11. Pomi&#324; LBFO i zainstaluj pozosta&#322;e wybrane pakiety lub anuluj." />
  <String Id="ForeignSkip" Value="&amp;Pomi&#324; LBFO" />
  <String Id="ForeignOnly" Value="LBFO jest ju&#380; zainstalowany przez inne narz&#281;dzie (np. Windows11LBFO) i jest jedynym wybranym pakietem. Aby go zast&#261;pi&#263;, u&#380;yj tools\Migrate-FromWindows11LBFO.ps1 z https://github.com/motwok/FeatureHeistWin11." />
